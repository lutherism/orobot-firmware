# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-slim AS builder

WORKDIR /build

# node-pty (a regular dependency) ships a native addon that node-gyp compiles
# from source, which needs python3 + a C/C++ toolchain. node:22-slim has none,
# so install them here. --omit=optional still skips node-libgpiod (RPi-only GPIO).
RUN apt-get update \
  && apt-get install -y --no-install-recommends python3 make g++ \
  && rm -rf /var/lib/apt/lists/*

# Copy manifests first for layer-cache efficiency
COPY package.json package-lock.json ./

# Install all deps (including devDeps needed for tsc)
RUN npm ci --omit=optional

# Copy source and compile
COPY tsconfig.json tsconfig.sim.json ./
COPY src/ ./src/

# Build main firmware modules + headless sim entry + sim-host entry
RUN npm run build:firmware

# Strip devDeps (keep prod + compiled native bindings) so the runtime stage can
# copy node_modules directly — no recompile, no toolchain in the final image.
RUN npm prune --omit=dev --omit=optional

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM node:22-slim AS runtime

# Non-root user for Cloud Run security best practice
RUN addgroup --system orobot && adduser --system --ingroup orobot orobot

WORKDIR /app

# Copy the pruned prod node_modules (native addons already compiled in builder —
# same base image / arch) plus manifest and compiled output. No npm install here,
# so the slim runtime needs no python3/g++.
COPY --from=builder /build/package.json ./package.json
COPY --from=builder /build/node_modules ./node_modules
COPY --from=builder /build/dist ./dist

# Make the bin executable
RUN chmod +x dist/sim-host/server.js

USER orobot

# Required env at runtime:
#   SIM_HOST_SECRET   Shared-secret bearer token for route auth
# Optional env:
#   PORT              HTTP listen port (default: 8080, Cloud Run convention)
#   SIM_HOST_MAX      Max concurrent sims (default: 32)
#   LOG_LEVEL         Pino log level (default: info)

ENV NODE_ENV=production \
    LOG_LEVEL=info \
    PORT=8080

EXPOSE 8080

ENTRYPOINT ["node", "dist/sim-host/server.js"]
