# ── Stage 1: build ────────────────────────────────────────────────────────────
FROM node:22-slim AS builder

WORKDIR /build

# Copy manifests first for layer-cache efficiency
COPY package.json package-lock.json ./

# Install all deps (including devDeps needed for tsc/tsx)
# --omit=optional skips node-libgpiod and any other hardware libs that require
# native GPIO headers only present on a Raspberry Pi.
RUN npm ci --omit=optional

# Copy source and compile
COPY tsconfig.json tsconfig.sim.json ./
COPY src/ ./src/

# Build main firmware types/modules + headless sim entry
RUN npm run build:firmware

# ── Stage 2: runtime ──────────────────────────────────────────────────────────
FROM node:22-slim AS runtime

# Non-root user for Cloud Run security best practice
RUN addgroup --system orobot && adduser --system --ingroup orobot orobot

WORKDIR /app

# Copy manifests for prod install
COPY package.json package-lock.json ./

# Production deps only; skip optional hardware libs
RUN npm ci --omit=dev --omit=optional && npm cache clean --force

# Copy compiled output from builder
COPY --from=builder /build/dist ./dist

# Make the bin executable
RUN chmod +x dist/simulator/headless.js

USER orobot

# Required env at runtime:
#   GATEWAY_WS_URL   wss://your-gateway/device
#   DEVICE_UUID      UUID registered in the gateway
# Optional:
#   DEVICE_SECRET    for REST auth (heartbeat session tokens, camera push)
#   LOG_LEVEL        pino level (default: info)
#   HEARTBEAT_MS     heartbeat interval ms (default: 8000)

ENV NODE_ENV=production \
    LOG_LEVEL=info

ENTRYPOINT ["node", "dist/simulator/headless.js"]
