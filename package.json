{
  "name": "orobot-firmware",
  "version": "0.1.0",
  "private": true,
  "bin": {
    "orobot-firmware-sim": "dist/simulator/headless.js",
    "orobot-sim-host": "dist/sim-host/server.js"
  },
  "scripts": {
    "simulator": "tsx src/simulator/server.ts",
    "sim:headless": "tsx src/simulator/headless.ts",
    "sim-host": "tsx src/sim-host/server.ts",
    "dev": "cross-env LOG_LEVEL=info tsx src/dev.ts",
    "dev:local": "cross-env LOG_LEVEL=info tsx src/dev.ts --local",
    "so101": "tsx src/bridges/so101/run.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "build:firmware": "tsc && tsc -p tsconfig.sim.json",
    "build:portal": "node scripts/build-portal.mjs",
    "build": "npm run build:firmware && npm run build:portal"
  },
  "parserOptions": {
    "sourceType": "module"
  },
  "dependencies": {
    "esptool-js": "^0.6.0",
    "express": "^5.2.1",
    "gpio": "^0.2.10",
    "node-pty": "^1.1.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "styled-components": "^6.4.1",
    "styletron-engine-monolithic": "^1.0.0",
    "styletron-react": "^6.1.0",
    "uuid": "^14.0.0",
    "ws": "^8.21.0"
  },
  "optionalDependencies": {
    "node-libgpiod": "^0.6.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.8.0",
    "@types/react": "^17.0.91",
    "@types/react-dom": "^17.0.26",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.7",
    "cross-env": "^10.1.0",
    "esbuild": "^0.25.12",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
